#!/bin/sh
# Budgets enforced by a mechanism rather than by remembering.
# Install with: make hooks
#
# The rules run over the tree being committed, not the working tree where an
# unstaged fix would hide a staged violation. The committed tree excludes
# intent-to-add entries and includes files absent from a sparse checkout.
# Repository-local Git variables are dropped before the checkers run.
set -e
# Local replacement objects are not part of the commit and must not repair it.
GIT_NO_REPLACE_OBJECTS=1
export GIT_NO_REPLACE_OBJECTS
# Installed somewhere shared (a global core.hooksPath), this runs in other
# repositories too; there it has nothing to check. This repository is the one
# whose last commit or whose index carries the validator — the index alone
# would let a commit that deletes the validator skip it.
if ! git cat-file -e :coding-tools/validate.py 2>/dev/null &&
		! git cat-file -e HEAD:coding-tools/validate.py 2>/dev/null; then
	exit 0
fi
tree=$(git write-tree)
if ! git cat-file -e "$tree:coding-tools/validate.py" 2>/dev/null; then
	if git cat-file -e HEAD:coding-tools/validate.py 2>/dev/null; then
		echo "this commit removes coding-tools/validate.py; commit that with --no-verify, deliberately" >&2
		exit 1
	fi
	exit 0
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM
tmp=$(cd "$tmp" && pwd -P)
mkdir "$tmp/tree"
git_vars=$(git rev-parse --local-env-vars)
# checkout-index applies smudge filters, encodings and line-ending conversions;
# archive can omit export-ignore files. Read the actual committed blobs instead.
# Isolated Python also keeps an unstaged module in the worktree off sys.path.
python3 -I - "$tree" "$tmp/tree" <<'PY'
import os
from pathlib import Path
import subprocess
import sys

git = ("git", "--no-replace-objects")
root = Path(sys.argv[2])
entries = subprocess.check_output((*git, "ls-tree", "-rz", "--full-tree", sys.argv[1]))
for entry in entries.split(b"\0"):
    if not entry:
        continue
    metadata, name = entry.split(b"\t", 1)
    mode, kind, oid = metadata.split()
    relative = Path(os.fsdecode(name))
    if relative.is_absolute() or ".." in relative.parts:
        raise ValueError("commit contains a path outside the snapshot")
    path = root / relative
    if not path.parent.resolve().is_relative_to(root):
        raise ValueError("commit path traverses a symlink outside the snapshot")
    path.parent.mkdir(parents=True, exist_ok=True)
    if mode == b"160000" and kind == b"commit":
        path.mkdir()  # A submodule's contents are not in this repository's tree.
        continue
    if kind != b"blob" or mode not in (b"100644", b"100755", b"120000"):
        raise ValueError("commit contains an unsupported entry type")
    contents = subprocess.check_output((*git, "cat-file", "blob", oid.decode("ascii")))
    if mode == b"120000":
        path.symlink_to(os.fsdecode(contents))
    else:
        path.write_bytes(contents)
        path.chmod(0o755 if mode == b"100755" else 0o644)
PY
# Git supplies variable names here, not values or shell code.
unset $git_vars
# TMPDIR may itself be inside this repository. Prevent discovery from walking
# up from the snapshot and finding the original .git again. The ceiling is a
# colon-separated list with no escape, so a path holding `:` cannot be fenced.
case "$tmp" in *:*)
	echo "the snapshot path $tmp contains ':', which Git cannot fence off; set TMPDIR to a path without one" >&2
	exit 1;;
esac
GIT_CEILING_DIRECTORIES="$tmp"
export GIT_CEILING_DIRECTORIES
cd "$tmp/tree"
python3 coding-tools/validate.py
python3 coding-tools/figures_check.py
